# The app's own state. Reproducible except notes.json, which is yours and
# should not be committed either - it is about positions, not about code.
data/

# Bundled fonts: the .ttf files are the person's own download (OFL, free from
# Google Fonts) and are not this project's to redistribute. The folder is
# kept so the loader has somewhere to look.
fonts/*
!fonts/.gitkeep

# Test fixtures are generated by tests/make_fixtures.py
tests/fakedata/

__pycache__/
*.py[cod]
.venv/
venv/
